    {
      "header": {
        "schema_version": "0.1.0",
        "event_id": "19d6516a-6e57-5ffe-ac8c-a6775b32c2e8",
        "author_id": "b3419a47-ab39-519c-80a8-941bc9ca6fde",
        "created_at": "2026-09-04T08:00:00Z",
        "visibility": "public",
        "references": []
      },
      "payload": {
        "kind": "dream",
        "data": {
          "text": "The empty harbor had tall open windows. Wind pushed paper tickets across its floor. There were no boats, just their outlines in dust.",
          "language": "en"
        }
      }
    },
    {
      "header": {
        "schema_version": "0.1.0",
        "event_id": "21bd4c4b-4776-5087-ae6a-9aaade0cf344",
        "author_id": "edcdf1bf-93bc-5ec7-9c45-de36a9d53e85",
        "created_at": "2026-09-04T08:00:00Z",
        "visibility": "public",
        "references": []
      },
      "payload": {
        "kind": "dream",
        "data": {
          "text": "I handed the conductor a leaf. Rain was falling inside the carriage. At the window I could see trees growing upside down.",
          "language": "en"
        }
      }
    },
    {
      "header": {
        "schema_version": "0.1.0",
        "event_id": "301b2a68-514f-50ed-812e-27c7026a2579",
        "author_id": "1c7b92d0-5f6b-5cbe-bf33-f4287ae828cd",
        "created_at": "2026-09-04T08:00:00Z",
        "visibility": "public",
        "references": []
      },
      "payload": {
        "kind": "dream",
        "data": {
          "text": "I could see a beach through a kitchen doorway. There was no horizon; a wall stood just beyond the breaking waves. I did not recognize the coast.",
          "language": "en"
        }
      }
    },
    {
      "header": {
        "schema_version": "0.1.0",
        "event_id": "964e4140-4b8b-51b1-b3ce-2f9e69ed9ab9",
        "author_id": "5c38dd17-3401-5b3c-a75e-6349a2947a06",
        "created_at": "2026-09-04T08:00:00Z",
        "visibility": "public",
        "references": []
      },
      "payload": {
        "kind": "dream",
        "data": {
          "text": "I remember waking with a feeling of urgency, but no scene or image remains.",
          "language": "en"
        }
      }
    },
    {
      "header": {
        "schema_version": "0.1.0",
        "event_id": "c4d4620a-0be5-5efc-a627-1c59d223f6d6",
        "author_id": "5c38dd17-3401-5b3c-a75e-6349a2947a06",
        "created_at": "2026-09-04T08:00:00Z",
        "visibility": "public",
        "references": []
      },
      "payload": {
        "kind": "dream",
        "data": {
          "text": "The library had an end. Behind its last shelf was a small garden and a locked gate. I was relieved that the corridors did not continue.",
          "language": "en"
        }
      }
    },
    {
      "header": {
        "schema_version": "0.1.0",
        "event_id": "d20e979a-6d12-5c17-9474-c47e9c8d3b1b",
        "author_id": "edcdf1bf-93bc-5ec7-9c45-de36a9d53e85",
        "created_at": "2026-09-04T08:00:00Z",
        "visibility": "public",
        "references": []
      },
      "payload": {
        "kind": "dream",
        "data": {
          "text": "I woke within the dream and saw an apple above my bed. It was attached to the ceiling by a thin root. I remembered the orchard I had imagined.",
          "language": "en"
        }
      }
    },
