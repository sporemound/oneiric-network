    {
      "header": {
        "schema_version": "0.1.0",
        "event_id": "2cf25f55-6296-59f0-b892-7b230157bfd1",
        "author_id": "90ccb567-7b37-5f37-8c55-31ade1ac42af",
        "created_at": "2026-09-02T08:00:00Z",
        "visibility": "public",
        "references": []
      },
      "payload": {
        "kind": "dream",
        "data": {
          "text": "A telephone rang beneath the snow. I dug with my hands but could never reach it. I woke before hearing a voice.",
          "language": "en"
        }
      }
    },
    {
      "header": {
        "schema_version": "0.1.0",
        "event_id": "3dfc504d-3c48-5881-be80-dd075cd296ce",
        "author_id": "90ccb567-7b37-5f37-8c55-31ade1ac42af",
        "created_at": "2026-09-02T08:00:00Z",
        "visibility": "public",
        "references": []
      },
      "payload": {
        "kind": "dream",
        "data": {
          "text": "There were boats in a tiled hall, but no water. I could hear a bell from somewhere beneath the floor. I never found the stairs.",
          "language": "en"
        }
      }
    },
    {
      "header": {
        "schema_version": "0.1.0",
        "event_id": "61ae80d2-8a8c-5424-b2b2-6dc9e0bcfc3a",
        "author_id": "edcdf1bf-93bc-5ec7-9c45-de36a9d53e85",
        "created_at": "2026-09-02T08:00:00Z",
        "visibility": "public",
        "references": []
      },
      "payload": {
        "kind": "dream",
        "data": {
          "text": "In the infinite library, a book opened into a little patch of rain. I closed it quickly because I was worried about the other books.",
          "language": "en"
        }
      }
    },
    {
      "header": {
        "schema_version": "0.1.0",
        "event_id": "9e70e280-b885-592f-91db-d240d0c16009",
        "author_id": "1c7b92d0-5f6b-5cbe-bf33-f4287ae828cd",
        "created_at": "2026-09-02T08:00:00Z",
        "visibility": "public",
        "references": []
      },
      "payload": {
        "kind": "dream",
        "data": {
          "text": "A train arrived without a sound. The station floor was wet, though I did not see rain. I was waiting for someone whose face I had forgotten.",
          "language": "en"
        }
      }
    },
    {
      "header": {
        "schema_version": "0.1.0",
        "event_id": "fcf382e0-3137-53d2-aa3e-bb8f541fa25f",
        "author_id": "b3419a47-ab39-519c-80a8-941bc9ca6fde",
        "created_at": "2026-09-02T08:00:00Z",
        "visibility": "public",
        "references": []
      },
      "payload": {
        "kind": "dream",
        "data": {
          "text": "I was on a Pacific beach looking for a stone with a hole in it. Each time I bent down, the sea seemed farther away.",
          "language": "en"
        }
      }
    },
