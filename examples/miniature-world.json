      "payload": {
        "kind": "annotation",
        "data": {
          "subject_event_id": "9e70e280-b885-592f-91db-d240d0c16009",
          "layer": "interpretation",
          "text": "I had read the rain-station description before this dream. Its wet floor should not be treated as an independent correspondence.",
          "exposure": "unknown"
        }
      }
    },
