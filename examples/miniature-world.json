        "kind": "place_observation",
        "data": {
          "place_id": "50f85b48-0259-5847-afeb-2e696c5c6a2f",
          "source_event_id": "131ec6c8-fa6a-5fc4-aa1a-28813ca10338",
          "dimension": "weather",
          "value": "Heat and dry tracks conflict with the rain description.",
