    {
      "header": {
        "schema_version": "0.1.0",
        "event_id": "6077b1b2-0351-549c-af02-506794018058",
        "author_id": "5c38dd17-3401-5b3c-a75e-6349a2947a06",
        "created_at": "2026-09-01T08:00:00Z",
        "visibility": "public",
        "references": []
      },
      "payload": {
        "kind": "dream",
        "data": {
          "text": "I stood at the Pacific shoreline. The wet sand was black and I could hear traffic behind me. Everything felt ordinary until the waves stopped.",
          "language": "en"
        }
      }
    },
    {
      "header": {
        "schema_version": "0.1.0",
        "event_id": "74501830-d58b-5651-962b-12ddea5161b0",
        "author_id": "edcdf1bf-93bc-5ec7-9c45-de36a9d53e85",
        "created_at": "2026-09-01T08:00:00Z",
        "visibility": "public",
        "references": []
      },
      "payload": {
        "kind": "dream",
        "data": {
          "text": "I imagined an orchard growing from a ceiling before sleep. In the dream, roots broke through the plaster and apples hung beside the lamps.",
          "language": "en"
        }
      }
    },
    {
      "header": {
        "schema_version": "0.1.0",
        "event_id": "9d6e3050-500d-54f6-ad96-06348de18b03",
        "author_id": "90ccb567-7b37-5f37-8c55-31ade1ac42af",
        "created_at": "2026-09-01T08:00:00Z",
        "visibility": "public",
        "references": []
      },
      "payload": {
        "kind": "dream",
        "data": {
          "text": "I dreamed of the infinite library from our invented story. Every door led back to the same reading room. The books had warm covers.",
          "language": "en"
        }
      }
    },
    {
      "header": {
        "schema_version": "0.1.0",
        "event_id": "c645f14d-8ce3-55e5-9739-10059036c5d2",
        "author_id": "1c7b92d0-5f6b-5cbe-bf33-f4287ae828cd",
        "created_at": "2026-09-01T08:00:00Z",
        "visibility": "public",
        "references": []
      },
      "payload": {
        "kind": "dream",
        "data": {
          "text": "I walked down a blue stairway into a harbor inside a building. The basin was dry. Each boat rested on its own small wooden stand.",
          "language": "en"
        }
      }
    },
    {
      "header": {
        "schema_version": "0.1.0",
        "event_id": "f939eb93-1758-589b-89bd-9f8e68c4d138",
        "author_id": "edcdf1bf-93bc-5ec7-9c45-de36a9d53e85",
        "created_at": "2026-09-01T08:00:00Z",
        "visibility": "public",
        "references": []
      },
      "payload": {
        "kind": "dream",
        "data": {
          "text": "Rain fell between two train platforms. The roof was unbroken. I held a ticket with the destination rubbed away.",
          "language": "en"
        }
      }
    },
