      "payload": {
        "kind": "place_observation",
        "data": {
          "place_id": "50f85b48-0259-5847-afeb-2e696c5c6a2f",
          "source_event_id": "f939eb93-1758-589b-89bd-9f8e68c4d138",
          "dimension": "weather",
          "value": "Rain falls beneath an intact station roof.",
          "stance": "supports",
          "exposure": "unknown"
        }
      }
    },
    {
      "header": {
        "schema_version": "0.1.0",
        "event_id": "131ec6c8-fa6a-5fc4-aa1a-28813ca10338",
        "author_id": "90ccb567-7b37-5f37-8c55-31ade1ac42af",
        "created_at": "2026-09-03T08:00:00Z",
        "visibility": "public",
        "references": []
      },
      "payload": {
        "kind": "dream",
        "data": {
          "text": "The train station was hot and completely dry. Someone told me to keep an umbrella open anyway. Dust collected on the tracks.",
          "language": "en"
        }
      }
    },
    {
      "header": {
        "schema_version": "0.1.0",
        "event_id": "400874dd-51ba-540c-8a84-c0e2124cbff0",
        "author_id": "5c38dd17-3401-5b3c-a75e-6349a2947a06",
        "created_at": "2026-09-03T08:00:00Z",
        "visibility": "public",
        "references": []
      },
      "payload": {
        "kind": "dream",
        "data": {
          "text": "At the foot of the blue stairs, the water reached my chest. A rowboat knocked against the handrail. There was daylight but no visible window.",
          "language": "en"
        }
      }
    },
    {
      "header": {
        "schema_version": "0.1.0",
        "event_id": "a4122280-9043-533b-b727-a973229bd347",
        "author_id": "b3419a47-ab39-519c-80a8-941bc9ca6fde",
        "created_at": "2026-09-03T08:00:00Z",
        "visibility": "public",
        "references": []
      },
      "payload": {
        "kind": "dream",
        "data": {
          "text": "The orchard was entirely ordinary. Trees grew out of the soil. One apple hovered above a branch, but nothing was upside down.",
          "language": "en"
        }
      }
    },
    {
      "header": {
        "schema_version": "0.1.0",
        "event_id": "ed70f337-b63a-570b-ae75-052c5bb72fa0",
        "author_id": "b3419a47-ab39-519c-80a8-941bc9ca6fde",
        "created_at": "2026-09-03T08:00:00Z",
        "visibility": "public",
        "references": []
      },
      "payload": {
        "kind": "dream",
        "data": {
          "text": "A flat red color. No room, no person, no story that I can remember.",
          "language": "en"
        }
      }
    },
    {
      "header": {
        "schema_version": "0.1.0",
        "event_id": "38960c1c-d858-57f2-b377-898c7cb9a18e",
